rules_version = '2';

// Who can do what in the Parish Family Register.
//   admin : everything, including editing families and approving requests
//   staff : view everything, enroll (as a request), record offerings, report events
//   anyone else : nothing
// The parish account in OWNER is always an admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner() { return 'officialholyeucharist@gmail.com'; }
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && request.auth.token.email_verified == true && myEmail() == owner(); }
    function hasUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isOwner() || (hasUser() && myRole() == 'admin'); }
    function isStaff() { return isAdmin() || (hasUser() && myRole() == 'staff'); }
    function invite() { return get(/databases/$(database)/documents/invites/$(myEmail())); }
    function invited() { return signedIn() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/invites/$(myEmail())); }

    // People and invitations
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && ((isOwner() && request.resource.data.role == 'admin')
            || (invited() && request.resource.data.role == invite().data.role));
      // People may update their own display name only; admins manage roles.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin() && resource.data.email != owner();
    }
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    // Families: staff read; only admins change. New families arrive as requests.
    match /families/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Offerings: staff record; only admins cancel or correct. Never deleted.
    match /payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Requests for approval: staff create their own; the requester may withdraw while pending.
    match /requests/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isStaff() && resource.data.requestedBy == request.auth.uid
            && !exists(/databases/$(database)/documents/decisions/$(id)));
    }
    match /decisions/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && request.resource.data.decidedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Change history: anyone working in the register adds entries; nobody edits or deletes them.
    match /history/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Receipt-number counters and the go-live checklist.
    match /counters/{id} { allow read, write: if isStaff(); }
    match /testrun/{id} { allow read, write: if isStaff(); }

    // Church details, approvers, Anbiyam leaders, last backup.
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
